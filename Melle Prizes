<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
<title>Prize Packs</title>
<style>
  /* ── Reset & base ── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --boy-primary: #1a6fbf;
    --boy-secondary: #0d9e4e;
    --boy-accent: #f5a623;
    --girl-primary: #e8469a;
    --girl-secondary: #ff8cc8;
    --girl-accent: #ffb7d5;
    --bg-dark: #12121a;
    --bg-card: #1e1e2e;
    --text-light: #f0f0f8;
    --text-muted: #888;
    --common-color: #aaaacc;
    --uncommon-color: #4dcc88;
    --rare-color: #4da6ff;
    --familyevent-color: #ff9f43;
  }

  html, body {
    height: 100%;
    background: var(--bg-dark);
    color: var(--text-light);
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    overflow: hidden;
  }
  .pack-wrapper {
    touch-action: none;
  }

  /* ── Screens ── */
  .screen {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .screen.hidden {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.96);
  }

  /* ── HOME SCREEN ── */
  #home-screen {
    background: radial-gradient(ellipse at 50% 0%, #2a1a3e 0%, var(--bg-dark) 70%);
    padding: 24px;
    gap: 32px;
  }
  #home-screen h1 {
    font-size: clamp(1.8rem, 6vw, 2.8rem);
    font-weight: 800;
    text-align: center;
    letter-spacing: -0.5px;
  }
  #home-screen h1 span { display: block; font-size: 0.45em; font-weight: 500; color: var(--text-muted); margin-top: 4px; letter-spacing: 0.5px; }

  .pack-selector {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .pack-card {
    width: 150px;
    cursor: pointer;
    border-radius: 20px;
    padding: 20px 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    border: 2px solid transparent;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  .pack-card:active { transform: scale(0.95); }
  .pack-card.boy {
    background: linear-gradient(145deg, #152a45, #1a3a60);
    box-shadow: 0 8px 32px rgba(26,111,191,0.3);
  }
  .pack-card.girl {
    background: linear-gradient(145deg, #3a1228, #501830);
    box-shadow: 0 8px 32px rgba(232,70,154,0.3);
  }
  .pack-card:hover { transform: translateY(-4px); }
  .pack-card.boy:hover { border-color: var(--boy-primary); box-shadow: 0 12px 40px rgba(26,111,191,0.5); }
  .pack-card.girl:hover { border-color: var(--girl-primary); box-shadow: 0 12px 40px rgba(232,70,154,0.5); }

  .pack-card .pack-icon { font-size: 3rem; line-height: 1; }
  .pack-card .pack-name { font-size: 1rem; font-weight: 700; text-align: center; }
  .pack-card .pack-sub { font-size: 0.72rem; color: var(--text-muted); text-align: center; }
  .pack-card .pack-count {
    font-size: 0.7rem;
    padding: 3px 10px;
    border-radius: 20px;
    font-weight: 600;
    margin-top: 4px;
  }
  .pack-card.boy .pack-count { background: rgba(26,111,191,0.25); color: #7bbfff; }
  .pack-card.girl .pack-count { background: rgba(232,70,154,0.25); color: #ffb0d8; }

  .home-footer { font-size: 0.72rem; color: var(--text-muted); text-align: center; }
  .home-footer button {
    background: none; border: none; color: #e05555; font-size: 0.72rem;
    cursor: pointer; text-decoration: underline; padding: 0;
  }

  /* ── PACK OPEN SCREEN ── */
  #pack-screen {
    background: var(--bg-dark);
    padding: 16px 16px 40px;
    gap: 16px;
    justify-content: flex-start;
    overflow-y: auto;
    padding-top: 20px;
    -webkit-overflow-scrolling: touch;
  }

  #pack-screen.theme-boy {
    background: radial-gradient(ellipse at 50% 30%, #0d2040 0%, var(--bg-dark) 70%);
  }
  #pack-screen.theme-girl {
    background: radial-gradient(ellipse at 50% 30%, #40091e 0%, var(--bg-dark) 70%);
  }

  .pack-screen-header {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 420px;
  }
  .back-btn {
    background: rgba(255,255,255,0.08);
    border: none;
    color: var(--text-light);
    font-size: 0.85rem;
    padding: 8px 14px;
    border-radius: 20px;
    cursor: pointer;
    transition: background 0.2s;
    -webkit-tap-highlight-color: transparent;
  }
  .back-btn:hover { background: rgba(255,255,255,0.14); }

  .pack-screen-title { font-size: 1rem; font-weight: 700; }

  .sound-btn {
    background: rgba(255,255,255,0.08);
    border: none;
    color: var(--text-light);
    font-size: 0.85rem;
    padding: 8px 14px;
    border-radius: 20px;
    cursor: pointer;
    transition: background 0.2s;
    -webkit-tap-highlight-color: transparent;
  }
  .sound-btn:hover { background: rgba(255,255,255,0.14); }

  /* ── THE PACK ── */
  #pack-stage {
    width: 220px;
    height: 300px;
    position: relative;
    flex-shrink: 0;
  }

  .pack-wrapper {
    width: 100%;
    height: 100%;
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    cursor: grab;
    user-select: none;
  }

  .pack-front, .pack-back {
    position: absolute;
    inset: 0;
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: clip-path 0.05s linear;
  }

  .pack-front.theme-boy {
    background: linear-gradient(160deg, #1a5fa0 0%, #0d3060 40%, #061830 100%);
    border: 2px solid rgba(77,166,255,0.4);
    box-shadow: 0 0 40px rgba(26,111,191,0.5), inset 0 0 60px rgba(0,0,0,0.3);
  }
  .pack-front.theme-girl {
    background: linear-gradient(160deg, #e8469a 0%, #a0205a 40%, #580a2a 100%);
    border: 2px solid rgba(255,180,215,0.4);
    box-shadow: 0 0 40px rgba(232,70,154,0.5), inset 0 0 60px rgba(0,0,0,0.3);
  }

  .pack-front .pack-emoji { font-size: 3.5rem; }
  .pack-front .pack-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .pack-front .pack-name-big {
    font-size: 1.4rem;
    font-weight: 800;
    text-align: center;
    padding: 0 12px;
    line-height: 1.2;
  }
  .pack-front .pack-shine {
    position: absolute;
    inset: 0;
    border-radius: 20px;
    background: linear-gradient(135deg, rgba(255,255,255,0.15) 0%, transparent 50%, rgba(255,255,255,0.05) 100%);
    pointer-events: none;
  }

  /* Knife indicator */
  .slice-hint {
    position: absolute;
    bottom: 16px;
    left: 0; right: 0;
    text-align: center;
    font-size: 0.72rem;
    color: rgba(255,255,255,0.5);
    pointer-events: none;
    animation: pulse-hint 2s ease-in-out infinite;
  }
  @keyframes pulse-hint { 0%,100% { opacity: 0.5 } 50% { opacity: 1 } }

  /* Slice line that follows the drag */
  #slice-line {
    position: absolute;
    top: 0; bottom: 0;
    width: 3px;
    background: linear-gradient(to bottom, transparent, rgba(255,255,255,0.9), transparent);
    pointer-events: none;
    opacity: 0;
    transform: translateX(-50%);
    filter: blur(1px);
    box-shadow: 0 0 8px rgba(255,255,255,0.8);
    border-radius: 4px;
  }

  /* Pack halves after cut */
  .pack-half {
    position: absolute;
    top: 0;
    width: 50%;
    height: 100%;
    overflow: hidden;
    transition: transform 0.5s cubic-bezier(0.34,1.56,0.64,1);
  }
  .pack-half.left { left: 0; transform-origin: left center; }
  .pack-half.right { right: 0; transform-origin: right center; }
  .pack-half.left.flung { transform: translateX(-120%) rotate(-15deg); }
  .pack-half.right.flung { transform: translateX(120%) rotate(15deg); }
  .pack-half .half-inner {
    position: absolute;
    top: 0;
    height: 100%;
  }
  .pack-half.left .half-inner { left: 0; width: 200%; }
  .pack-half.right .half-inner { right: 0; width: 200%; }

  /* ── PRIZE REVEAL ── */
  #prize-reveal {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
    animation: prize-pop 0.5s cubic-bezier(0.34,1.56,0.64,1) both;
  }
  #prize-reveal.visible { display: flex; }
  @keyframes prize-pop {
    0% { opacity: 0; transform: scale(0.5) translateY(20px); }
    100% { opacity: 1; transform: scale(1) translateY(0); }
  }

  .prize-tier-badge {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 3px;
    text-transform: uppercase;
    padding: 5px 14px;
    border-radius: 20px;
  }
  .prize-tier-badge.common      { background: rgba(170,170,204,0.2); color: var(--common-color);      border: 1px solid rgba(170,170,204,0.3); }
  .prize-tier-badge.uncommon    { background: rgba(77,204,136,0.15); color: var(--uncommon-color);    border: 1px solid rgba(77,204,136,0.35); }
  .prize-tier-badge.rare        { background: rgba(77,166,255,0.2);  color: var(--rare-color);        border: 1px solid rgba(77,166,255,0.4); }
  .prize-tier-badge.familyevent { background: rgba(255,159,67,0.15); color: var(--familyevent-color); border: 1px solid rgba(255,159,67,0.4); animation: glow-orange 1.5s ease-in-out infinite; }

  @keyframes glow-orange {
    0%,100% { box-shadow: 0 0 8px rgba(255,159,67,0.3); }
    50% { box-shadow: 0 0 20px rgba(255,159,67,0.7); }
  }

  /* ── WHAT'S INSIDE ── */
  .whats-inside {
    width: 100%;
    max-width: 420px;
    margin-top: 8px;
  }
  .whats-inside-title {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--text-muted);
    text-align: center;
    margin-bottom: 12px;
  }
  .wi-tier {
    margin-bottom: 14px;
  }
  .wi-tier-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }
  .wi-tier-name {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  .wi-tier-name.common      { color: var(--common-color); }
  .wi-tier-name.uncommon    { color: var(--uncommon-color); }
  .wi-tier-name.rare        { color: var(--rare-color); }
  .wi-tier-name.familyevent { color: var(--familyevent-color); }
  .wi-tier-chance {
    font-size: 0.65rem;
    color: var(--text-muted);
    background: rgba(255,255,255,0.06);
    padding: 2px 8px;
    border-radius: 10px;
  }
  .wi-prizes {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .wi-prize {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(255,255,255,0.04);
    border-radius: 12px;
    padding: 8px 12px;
  }
  .wi-prize-emoji { font-size: 1.3rem; flex-shrink: 0; }
  .wi-prize-info { display: flex; flex-direction: column; gap: 1px; }
  .wi-prize-name { font-size: 0.8rem; font-weight: 700; }
  .wi-prize-desc { font-size: 0.7rem; color: var(--text-muted); line-height: 1.4; }
  .wi-divider {
    height: 1px;
    background: rgba(255,255,255,0.06);
    margin: 4px 0 14px;
  }

  .prize-emoji { font-size: 4.5rem; line-height: 1; animation: prize-pop 0.6s 0.1s cubic-bezier(0.34,1.56,0.64,1) both; }
  .prize-name { font-size: 1.5rem; font-weight: 800; line-height: 1.2; animation: prize-pop 0.6s 0.15s cubic-bezier(0.34,1.56,0.64,1) both; }
  .prize-desc { font-size: 0.85rem; color: var(--text-muted); max-width: 240px; animation: prize-pop 0.6s 0.2s cubic-bezier(0.34,1.56,0.64,1) both; }

  .prize-actions {
    display: flex;
    gap: 12px;
    margin-top: 4px;
    animation: prize-pop 0.6s 0.3s cubic-bezier(0.34,1.56,0.64,1) both;
  }
  .btn-primary {
    padding: 12px 24px;
    border: none;
    border-radius: 30px;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.15s, box-shadow 0.15s;
    -webkit-tap-highlight-color: transparent;
  }
  .btn-primary:active { transform: scale(0.95); }
  .btn-primary.theme-boy { background: linear-gradient(135deg, var(--boy-primary), var(--boy-secondary)); color: #fff; box-shadow: 0 4px 16px rgba(26,111,191,0.4); }
  .btn-primary.theme-girl { background: linear-gradient(135deg, var(--girl-primary), var(--girl-secondary)); color: #fff; box-shadow: 0 4px 16px rgba(192,79,214,0.4); }
  .btn-primary:hover { transform: translateY(-2px); }
  .btn-primary:active { transform: scale(0.95) translateY(0); }

  .btn-secondary {
    padding: 12px 20px;
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 30px;
    background: transparent;
    color: var(--text-light);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s, transform 0.15s;
    -webkit-tap-highlight-color: transparent;
  }
  .btn-secondary:hover { background: rgba(255,255,255,0.08); }
  .btn-secondary:active { transform: scale(0.95); }

  /* ── INSTRUCTION ── */
  .open-instruction {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.4);
    text-align: center;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .open-instruction span { animation: slide-arrow 1.5s ease-in-out infinite; display: inline-block; }
  @keyframes slide-arrow { 0%,100% { transform: translateX(0); } 50% { transform: translateX(6px); } }

  /* ── CONFETTI ── */
  #confetti-canvas {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 100;
  }

  /* ── Pack count ── */
  .pack-stat {
    font-size: 0.72rem;
    color: var(--text-muted);
    background: rgba(255,255,255,0.05);
    padding: 5px 14px;
    border-radius: 20px;
  }
  .pack-stat strong { color: var(--text-light); }

  /* Tier breakdown hint */
  .tier-hint {
    font-size: 0.68rem;
    color: var(--text-muted);
    text-align: center;
    max-width: 260px;
    line-height: 1.6;
  }
  .tier-hint .c { color: var(--common-color); }
  .tier-hint .r { color: var(--rare-color); }
  .tier-hint .sr { color: var(--superrare-color); }
</style>
</head>
<body>

<canvas id="confetti-canvas"></canvas>

<!-- ═══════════════════════════════════════
     HOME SCREEN
═══════════════════════════════════════ -->
<div id="home-screen" class="screen">
  <h1>Prize Packs <span>Choose your pack to open</span></h1>

  <div class="pack-selector">
    <!-- BOY PACK -->
    <div class="pack-card boy" onclick="selectPack('boy')" role="button" tabindex="0" aria-label="Open Hudson's Pack">
      <div class="pack-icon">🦕</div>
      <div class="pack-name">Hudson's Pack</div>
      <div class="pack-sub">For the little explorer</div>
      <div class="pack-count" id="boy-count">0 opened</div>
    </div>

    <!-- GIRL PACK -->
    <div class="pack-card girl" onclick="selectPack('girl')" role="button" tabindex="0" aria-label="Open Monroe's Pack">
      <div class="pack-icon">🌸</div>
      <div class="pack-name">Monroe's Pack</div>
      <div class="pack-sub">For the little flower lover</div>
      <div class="pack-count" id="girl-count">0 opened</div>
    </div>
  </div>

  <div class="tier-hint">
    <span class="c">●</span> Common (60%) &nbsp;
    <span class="r">●</span> Rare (30%) &nbsp;
    <span class="sr">●</span> Super Rare (10%)
  </div>

  <div class="home-footer">
    Edit prizes near the top of the &lt;script&gt; tag &nbsp;·&nbsp;
    <button onclick="resetProgress()">reset progress</button>
  </div>
</div>

<!-- ═══════════════════════════════════════
     PACK OPEN SCREEN
═══════════════════════════════════════ -->
<div id="pack-screen" class="screen hidden">
  <div class="pack-screen-header">
    <button class="back-btn" onclick="goHome()">← Back</button>
    <div class="pack-screen-title" id="pack-screen-title">Dino Pack</div>
    <button class="sound-btn" id="sound-btn" onclick="toggleSound()">🔊</button>
  </div>

  <!-- Pack stage (slice zone) -->
  <div id="pack-stage">
    <div class="pack-wrapper" id="pack-wrapper">
      <div class="pack-front" id="pack-front">
        <div class="pack-shine"></div>
        <div class="pack-label">PRIZE PACK</div>
        <div class="pack-emoji" id="pack-emoji">🦕</div>
        <div class="pack-name-big" id="pack-name-big">Dino Pack</div>
        <div class="slice-hint">↔ Drag to slice open</div>
      </div>
      <div id="slice-line"></div>
    </div>
  </div>

  <div class="open-instruction" id="open-instruction">
    <span>→</span> Drag your finger across the pack <span>←</span>
  </div>

  <!-- Prize reveal (hidden until pack opened) -->
  <div id="prize-reveal">
    <div class="prize-tier-badge" id="prize-tier-badge">COMMON</div>
    <div class="prize-emoji" id="prize-emoji">🎉</div>
    <div class="prize-name" id="prize-name">Prize Name</div>
    <div class="prize-desc" id="prize-desc">Prize description goes here.</div>
    <div class="prize-actions">
      <button class="btn-primary" id="next-pack-btn" onclick="nextPack()">Open Another Pack 🎁</button>
      <button class="btn-secondary" onclick="goHome()">Home</button>
    </div>
  </div>

  <div class="pack-stat" id="pack-stat">Opened: <strong>0</strong> packs</div>

  <!-- What's Inside -->
  <div class="whats-inside" id="whats-inside">
    <div class="wi-divider"></div>
    <div class="whats-inside-title">What's Inside</div>
    <div id="wi-content"><!-- populated by JS --></div>
  </div>
</div>

<script>
