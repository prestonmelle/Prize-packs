// Drop rates (must sum to 1.0)
const TIER_RATES = { common: 0.53, uncommon: 0.30, rare: 0.10, familyevent: 0.07 };

// Tier display config
const TIER_META = {
  common:      { label: 'Common',       chance: '53%' },
  uncommon:    { label: 'Uncommon',     chance: '30%' },
  rare:        { label: 'Rare',         chance: '10%' },
  familyevent: { label: 'Family Event', chance: '7%'  },
};

// ════════════════════════════════════════════════════════
//  STATE
// ════════════════════════════════════════════════════════
let state = {
  soundOn: true,
  currentPack: null,  // 'boy' | 'girl'
  counts: { boy: 0, girl: 0 },
};

// Load saved counts
try {
  const saved = JSON.parse(localStorage.getItem('prizepackState') || '{}');
  if (saved.counts) state.counts = saved.counts;
} catch(e) {}

function saveState() {
  localStorage.setItem('prizepackState', JSON.stringify({ counts: state.counts }));
}

// ════════════════════════════════════════════════════════
//  NAVIGATION
// ════════════════════════════════════════════════════════
function selectPack(type) {
  state.currentPack = type;
  const theme = type === 'boy' ? 'theme-boy' : 'theme-girl';
  const emoji = type === 'boy' ? '🦕' : '🌸';
  const name  = type === 'boy' ? "Hudson's Pack" : "Monroe's Pack";
  const color = type === 'boy' ? 'var(--boy-primary)' : 'var(--girl-primary)';

  // Set up UI
  document.getElementById('pack-screen-title').textContent = name;
  document.getElementById('pack-emoji').textContent = emoji;
  document.getElementById('pack-name-big').textContent = name;
  document.getElementById('next-pack-btn').className = `btn-primary ${theme}`;

  const pf = document.getElementById('pack-front');
  pf.className = `pack-front ${theme}`;

  const ps = document.getElementById('pack-screen');
  ps.className = `screen ${theme}`;

  updatePackStat();
  resetPackAnimation();
  populateWhatsInside(type);
  showScreen('pack-screen');
}

function goHome() {
  showScreen('home-screen');
  updateHomeCounts();
}

function showScreen(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.add('hidden'));
  document.getElementById(id).classList.remove('hidden');
}

function resetProgress() {
  if (!confirm('Reset all pack counts? This cannot be undone.')) return;
  state.counts = { boy: 0, girl: 0 };
  saveState();
  updateHomeCounts();
}

function updateHomeCounts() {
  document.getElementById('boy-count').textContent = state.counts.boy + ' opened';
  document.getElementById('girl-count').textContent = state.counts.girl + ' opened';
}

function updatePackStat() {
  const n = state.counts[state.currentPack] || 0;
  document.getElementById('pack-stat').innerHTML = `Opened: <strong>${n}</strong> pack${n !== 1 ? 's' : ''}`;
}

// ════════════════════════════════════════════════════════
//  SOUND
// ════════════════════════════════════════════════════════
const AudioCtx = window.AudioContext || window.webkitAudioContext;
let audioCtx = null;

function getAudioCtx() {
  if (!audioCtx) audioCtx = new AudioCtx();
  return audioCtx;
}

function playSliceSound() {
  if (!state.soundOn) return;
  try {
    const ctx = getAudioCtx();
    const buf = ctx.createBuffer(1, ctx.sampleRate * 0.3, ctx.sampleRate);
    const data = buf.getChannelData(0);
    for (let i = 0; i < data.length; i++) {
      data[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / data.length, 2) * 0.4;
    }
    const src = ctx.createBufferSource();
    const filter = ctx.createBiquadFilter();
    filter.type = 'bandpass';
    filter.frequency.value = 2000 + Math.random() * 2000;
    filter.Q.value = 0.5;
    src.buffer = buf;
    src.connect(filter);
    filter.connect(ctx.destination);
    src.start();
  } catch(e) {}
}

function playRevealSound(tier) {
  if (!state.soundOn) return;
  try {
    const ctx = getAudioCtx();
    const notes = tier === 'superrare' ? [523, 659, 784, 1047] : tier === 'rare' ? [440, 554, 659] : [330, 415];
    notes.forEach((freq, i) => {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.value = freq;
      gain.gain.setValueAtTime(0, ctx.currentTime + i * 0.12);
      gain.gain.linearRampToValueAtTime(0.18, ctx.currentTime + i * 0.12 + 0.04);
      gain.gain.linearRampToValueAtTime(0, ctx.currentTime + i * 0.12 + 0.22);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start(ctx.currentTime + i * 0.12);
      osc.stop(ctx.currentTime + i * 0.12 + 0.25);
    });
  } catch(e) {}
}

function toggleSound() {
  state.soundOn = !state.soundOn;
  document.getElementById('sound-btn').textContent = state.soundOn ? '🔊' : '🔇';
}

// ════════════════════════════════════════════════════════
//  PACK ANIMATION
// ════════════════════════════════════════════════════════
let isDragging = false;
let dragStartX = null;
let dragCurrentX = null;
let packOpened = false;
let sliceTriggered = false;

const packWrapper = document.getElementById('pack-wrapper');
const sliceLine   = document.getElementById('slice-line');

function resetPackAnimation() {
  packOpened = false;
  sliceTriggered = false;
  isDragging = false;

  const pf = document.getElementById('pack-front');
  pf.style.display = 'flex';
  pf.style.clipPath = '';

  sliceLine.style.opacity = '0';
  sliceLine.style.left = '50%';

  document.getElementById('prize-reveal').classList.remove('visible');
  document.getElementById('open-instruction').style.display = 'flex';
  document.getElementById('pack-stat').style.display = '';

  // Remove any old halves
  document.querySelectorAll('.pack-half').forEach(e => e.remove());
}

function getEventX(e) {
  if (e.touches && e.touches.length > 0) return e.touches[0].clientX;
  if (e.changedTouches && e.changedTouches.length > 0) return e.changedTouches[0].clientX;
  return e.clientX;
}

function getEventY(e) {
  if (e.touches && e.touches.length > 0) return e.touches[0].clientY;
  if (e.changedTouches && e.changedTouches.length > 0) return e.changedTouches[0].clientY;
  return e.clientY;
}

packWrapper.addEventListener('mousedown', startDrag, { passive: false });
packWrapper.addEventListener('touchstart', startDrag, { passive: false });
window.addEventListener('mousemove', moveDrag, { passive: false });
window.addEventListener('touchmove', moveDrag, { passive: false });
window.addEventListener('mouseup', endDrag);
window.addEventListener('touchend', endDrag);

function startDrag(e) {
  if (packOpened) return;
  e.preventDefault();
  isDragging = true;
  dragStartX = getEventX(e);
  dragCurrentX = dragStartX;
  sliceLine.style.opacity = '1';
}

function moveDrag(e) {
  if (!isDragging || packOpened) return;
  e.preventDefault();
  dragCurrentX = getEventX(e);

  const rect = packWrapper.getBoundingClientRect();
  const relX = dragCurrentX - rect.left;
  const pct = Math.max(0, Math.min(100, (relX / rect.width) * 100));

  sliceLine.style.left = pct + '%';

  // Wobble the pack slightly
  const delta = dragCurrentX - dragStartX;
  packWrapper.style.transform = `rotate(${delta * 0.03}deg)`;

  // Trigger slice if dragged far enough
  const dragDist = Math.abs(delta);
  if (dragDist > 60 && !sliceTriggered) {
    sliceTriggered = true;
    triggerSlice(pct, rect);
  }
}

function endDrag(e) {
  if (!isDragging) return;
  isDragging = false;
  if (!packOpened) {
    sliceLine.style.opacity = '0';
    packWrapper.style.transform = '';
  }
}

function triggerSlice(cutPct, rect) {
  packOpened = true;
  playSliceSound();

  const pf = document.getElementById('pack-front');
  const theme = state.currentPack === 'boy' ? 'theme-boy' : 'theme-girl';

  // Build two halves that mirror the original appearance
  function makeHalf(side) {
    const half = document.createElement('div');
    half.className = `pack-half ${side}`;

    const inner = document.createElement('div');
    inner.className = 'half-inner';

    // Clone the pack front visuals
    const clone = pf.cloneNode(true);
    clone.style.position = 'relative';
    clone.style.borderRadius = '20px';
    clone.style.width = '220px'; // full pack width
    clone.style.height = '100%';
    clone.style.display = 'flex';
    inner.appendChild(clone);
    half.appendChild(inner);
    return half;
  }

  const leftHalf  = makeHalf('left');
  const rightHalf = makeHalf('right');

  pf.style.display = 'none';
  sliceLine.style.opacity = '0';
  packWrapper.style.transform = '';

  packWrapper.appendChild(leftHalf);
  packWrapper.appendChild(rightHalf);

  // Animate the halves flying apart after a short pause
  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      leftHalf.classList.add('flung');
      rightHalf.classList.add('flung');
    });
  });

  // Show prize after animation
  setTimeout(() => {
    revealPrize();
  }, 550);
}

// ════════════════════════════════════════════════════════
//  PRIZE LOGIC
// ════════════════════════════════════════════════════════
function rollTier() {
  const r = Math.random();
  if (r < TIER_RATES.familyevent) return 'familyevent';
  if (r < TIER_RATES.familyevent + TIER_RATES.rare) return 'rare';
  if (r < TIER_RATES.familyevent + TIER_RATES.rare + TIER_RATES.uncommon) return 'uncommon';
  return 'common';
}

function revealPrize() {
  const tier   = rollTier();
  const pool   = PRIZES[state.currentPack][tier];
  const prize  = pool[Math.floor(Math.random() * pool.length)];

  const badge  = document.getElementById('prize-tier-badge');
  badge.className = `prize-tier-badge ${tier}`;
  const tierLabels = { common: 'COMMON', uncommon: '✨ UNCOMMON', rare: '💎 RARE', familyevent: '🎉 FAMILY EVENT' };
  badge.textContent = tierLabels[tier] || tier.toUpperCase();

  document.getElementById('prize-emoji').textContent = prize.emoji;
  document.getElementById('prize-name').textContent  = prize.name;
  document.getElementById('prize-desc').textContent  = prize.desc;

  document.getElementById('prize-reveal').classList.add('visible');
  document.getElementById('open-instruction').style.display = 'none';
  document.getElementById('pack-stage').style.opacity = '0.1';

  // Update count
  state.counts[state.currentPack] = (state.counts[state.currentPack] || 0) + 1;
  saveState();
  updatePackStat();

  playRevealSound(tier);

  if (tier !== 'common') {
    launchConfetti(tier);
  }
}

function nextPack() {
  document.getElementById('pack-stage').style.opacity = '1';
  resetPackAnimation();
}

function populateWhatsInside(type) {
  const packPrizes = PRIZES[type];
  const tierOrder = ['common', 'uncommon', 'rare', 'familyevent'];
  const container = document.getElementById('wi-content');

  container.innerHTML = tierOrder.map(tier => {
    const meta = TIER_META[tier];
    const prizes = packPrizes[tier];
    return `
      <div class="wi-tier">
        <div class="wi-tier-header">
          <div class="wi-tier-name ${tier}">${meta.label}</div>
          <div class="wi-tier-chance">${meta.chance} chance</div>
        </div>
        <div class="wi-prizes">
          ${prizes.map(p => `
            <div class="wi-prize">
              <div class="wi-prize-emoji">${p.emoji}</div>
              <div class="wi-prize-info">
                <div class="wi-prize-name">${p.name}</div>
                <div class="wi-prize-desc">${p.desc}</div>
              </div>
            </div>
          `).join('')}
        </div>
      </div>
    `;
  }).join('');
}

// ════════════════════════════════════════════════════════
//  CONFETTI
// ════════════════════════════════════════════════════════
const canvas  = document.getElementById('confetti-canvas');
const ctx2d   = canvas.getContext('2d');
let confettiParticles = [];
let confettiRAF = null;

function launchConfetti(tier) {
  canvas.width  = window.innerWidth;
  canvas.height = window.innerHeight;

  const isBoy = state.currentPack === 'boy';
  const colors = tier === 'familyevent'
    ? ['#ffd700','#ffec80','#ff9500','#fff','#ffe87a','#ff6b6b']
    : isBoy
      ? ['#4da6ff','#80caff','#4dcc88','#ffffff','#a8f0c6']
      : ['#ff6bac','#ffb0d5','#ff8cc8','#ffffff','#ffd6eb'];

  const count = tier === 'familyevent' ? 140 : 80;

  confettiParticles = [];
  for (let i = 0; i < count; i++) {
    confettiParticles.push({
      x: Math.random() * canvas.width,
      y: -20 - Math.random() * 120,
      w: 6 + Math.random() * 10,
      h: 4 + Math.random() * 6,
      color: colors[Math.floor(Math.random() * colors.length)],
      vx: (Math.random() - 0.5) * 4,
      vy: 2 + Math.random() * 4,
      spin: (Math.random() - 0.5) * 0.2,
      angle: Math.random() * Math.PI * 2,
      opacity: 1,
    });
  }

  if (confettiRAF) cancelAnimationFrame(confettiRAF);
  animateConfetti();
}

function animateConfetti() {
  ctx2d.clearRect(0, 0, canvas.width, canvas.height);
  let alive = false;

  confettiParticles.forEach(p => {
    p.x += p.vx;
    p.y += p.vy;
    p.vy += 0.08;
    p.angle += p.spin;
    if (p.y > canvas.height * 0.7) p.opacity -= 0.025;
    p.opacity = Math.max(0, p.opacity);

    if (p.opacity > 0) {
      alive = true;
      ctx2d.save();
      ctx2d.globalAlpha = p.opacity;
      ctx2d.translate(p.x, p.y);
      ctx2d.rotate(p.angle);
      ctx2d.fillStyle = p.color;
      ctx2d.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
      ctx2d.restore();
    }
  });

  if (alive) {
    confettiRAF = requestAnimationFrame(animateConfetti);
  } else {
    ctx2d.clearRect(0, 0, canvas.width, canvas.height);
  }
}

// ════════════════════════════════════════════════════════
//  INIT
// ════════════════════════════════════════════════════════
updateHomeCounts();
showScreen('home-screen');

// Keyboard support for pack cards
document.querySelectorAll('.pack-card').forEach(card => {
  card.addEventListener('keydown', e => {
    if (e.key === 'Enter' || e.key === ' ') card.click();
  });
});

window.addEventListener('resize', () => {
  if (confettiParticles.length) {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  }
});
</script>
